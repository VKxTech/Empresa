<!DOCTYPE html>
<html lang="<%= lang %>" <%- lang === 'ar' ? 'dir="rtl"' : '' %>>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= t.download.title %></title>
    <meta name="description" content="<%= t.download.general_subtitle %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" href="/logo.png" type="image/png">
    <style>
        :root {
            --bg: #0A0F1C;
            --card: rgba(255,255,255,0.03);
            --border: rgba(255,255,255,0.08);
            --accent: #10B981;
            --accent-soft: rgba(16,185,129,0.12);
            --text: #F8FAFC;
            --muted: #94A3B8;
            --font: 'Inter', sans-serif;
            --display: 'Outfit', sans-serif;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            background: radial-gradient(1200px 600px at 80% -10%, rgba(16,185,129,0.10), transparent 60%),
                        radial-gradient(900px 500px at -10% 110%, rgba(16,185,129,0.06), transparent 55%),
                        var(--bg);
            color: var(--text); font-family: var(--font);
            min-height: 100vh; display: flex; flex-direction: column;
            align-items: center; justify-content: center; padding: 24px;
            -webkit-font-smoothing: antialiased;
        }
        .card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 28px; padding: 44px 32px; width: 100%; max-width: 440px;
            text-align: center; backdrop-filter: blur(20px);
            box-shadow: 0 30px 80px -24px rgba(0,0,0,0.6);
            animation: in .7s cubic-bezier(0.16,1,0.3,1);
        }
        @keyframes in { from { opacity:0; transform: translateY(28px); } to { opacity:1; transform: none; } }
        .logo { width: 84px; height: 84px; border-radius: 22px; margin: 0 auto 26px; display:flex; align-items:center; justify-content:center;
            background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)); border:1px solid var(--border); }
        .logo img { width: 56px; height: 56px; object-fit: contain; }
        .headline { font-family: var(--display); font-size: 30px; font-weight: 800; line-height: 1.12; letter-spacing: -1px; margin-bottom: 12px; }
        .headline span { color: var(--accent); }
        .subtitle { font-size: 15px; line-height: 1.6; color: var(--muted); margin-bottom: 28px; }
        .gift {
            display:inline-flex; align-items:center; gap:8px; padding:10px 18px; margin-bottom: 28px;
            background: var(--accent-soft); border: 1px solid rgba(16,185,129,0.35); border-radius: 100px;
            font-size: 13px; font-weight: 700; color: #6EE7B7;
        }
        .stores { display:flex; gap: 12px; }
        .badge {
            flex:1; display:flex; align-items:center; justify-content:center; gap:10px;
            background:#000; border:1px solid rgba(255,255,255,0.14); border-radius:14px;
            padding:12px 10px; text-decoration:none; color:#fff; transition: transform .15s, border-color .2s;
        }
        .badge:active { transform: scale(0.97); }
        .badge:hover { border-color: rgba(255,255,255,0.3); }
        .badge svg { flex-shrink:0; }
        .badge .b-top { font-size: 9px; line-height:1; color:#cbd5e1; text-transform: uppercase; letter-spacing:.06em; }
        .badge .b-main { font-size: 15px; font-weight: 700; line-height: 1.15; }
        .open-link { display:inline-block; margin-top: 22px; font-size: 13px; color: var(--muted); text-decoration: none; font-weight:600; }
        .open-link:hover { color: var(--text); }
        .footer { margin-top: 40px; text-align:center; }
        .footer-links { display:flex; gap: 20px; justify-content:center; margin-bottom: 10px; flex-wrap: wrap; }
        .footer-links a { font-size: 12px; color: var(--muted); text-decoration:none; font-weight:600; }
        .footer-links a:hover { color: var(--text); }
        .footer-copy { font-size: 10px; color: rgba(148,163,184,0.5); text-transform: uppercase; letter-spacing:.1em; font-weight:700; }
        .toast { position: fixed; bottom: 28px; background: var(--accent); color:#04231a; padding: 12px 22px; border-radius: 14px; font-size: 13px; font-weight: 800; transform: translateY(120px); transition: transform .4s; }
        .toast.show { transform: none; }
        .hidden { display:none !important; }
        @media (max-width: 380px) { .stores { flex-direction: column; } }
    </style>
</head>
<body>
    <main class="card">
        <div class="logo"><img src="/logo.png" alt="VKX Wallet"></div>

        <h1 class="headline">
            <% if (ref) { %><%- t.download.invite_headline %><% } else { %><%- t.download.general_headline %><% } %>
        </h1>
        <p class="subtitle">
            <% if (ref) { %><%= t.download.invite_subtitle %><% } else { %><%= t.download.general_subtitle %><% } %>
        </p>

        <% if (ref) { %>
        <div class="gift">🎁 Bônus ativado — código <strong><%= ref %></strong></div>
        <% } %>

        <div class="stores">
            <a class="badge" id="btn-ios" href="https://apps.apple.com/app/vkx-wallet/id6759741026">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                <span style="text-align:left"><span class="b-top">Baixar na</span><br><span class="b-main">App Store</span></span>
            </a>
            <a class="badge" id="btn-android" href="https://play.google.com/store/apps/details?id=com.vkinha.wallet<%= ref ? '&referrer=' + encodeURIComponent('ref=' + ref) : '' %>">
                <svg width="22" height="22" viewBox="0 0 24 24"><path fill="#00D2FF" d="M3.6 1.8 13.8 12 3.6 22.2a1 1 0 0 1-.6-.9V2.7a1 1 0 0 1 .6-.9z"/><path fill="#00E676" d="M16.8 9 5.9 2.7l8.6 8.6L16.8 9z"/><path fill="#FF3D00" d="M16.8 15l-2.3-2.3-8.6 8.6L16.8 15z"/><path fill="#FFC400" d="m16.8 9 3.5 2a1 1 0 0 1 0 1.8l-3.5 2-2.3-2.9L16.8 9z"/></svg>
                <span style="text-align:left"><span class="b-top">Disponível no</span><br><span class="b-main">Google Play</span></span>
            </a>
        </div>

        <a class="open-link" href="#" onclick="tryOpenApp(); return false;">Já tem o app? Abrir a VKX Wallet →</a>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="https://vkxtech.com.br" target="_blank" rel="noreferrer">Site oficial</a>
            <a href="https://www.vkinha.com/blog" target="_blank" rel="noreferrer">Blog</a>
            <a href="https://wallet.vkxtech.com.br/privacy-policy" target="_blank" rel="noreferrer">Privacidade</a>
            <a href="https://t.me/canalvkx" target="_blank" rel="noreferrer">Comunidade</a>
        </div>
        <div class="footer-copy">© 2026 VKX Technologies</div>
    </footer>

    <div class="toast" id="toast"><%= t.download.toast_copy %></div>

    <script>
        const refCode = "<%= ref %>";
        const DEEP_LINK = "vkxwallet://" + (refCode ? "?ref=" + encodeURIComponent(refCode) : "");
        const ua = navigator.userAgent;
        const isAndroid = /android/i.test(ua);
        const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const PLAY_STORE_URL = document.getElementById('btn-android').href;
        const APP_STORE_URL = document.getElementById('btn-ios').href;

        function tryOpenApp() {
            const start = Date.now();
            window.location.href = DEEP_LINK;
            setTimeout(() => {
                if (Date.now() - start < 2500 && document.visibilityState !== 'hidden') {
                    if (isAndroid) window.location.href = PLAY_STORE_URL;
                    else if (isIOS) window.location.href = APP_STORE_URL;
                }
            }, 1800);
        }

        // iOS: copia o ref pro clipboard (o app lê no 1º open) — preserva a atribuição.
        if (isIOS && refCode) {
            try {
                navigator.clipboard.writeText(refCode).then(() => {
                    const toast = document.getElementById('toast');
                    if (toast) { toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 3000); }
                }).catch(() => {});
            } catch (e) {}
        }

        // Auto-tenta abrir o app instalado; se não, o usuário escolhe a loja.
        if (isAndroid || isIOS) {
            setTimeout(() => { if (document.visibilityState !== 'hidden') tryOpenApp(); }, 800);
        }
    </script>
</body>
</html>
