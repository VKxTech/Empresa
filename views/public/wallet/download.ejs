<!DOCTYPE html>
<html lang="<%= lang %>" <%- lang === 'ar' ? 'dir="rtl"' : '' %>>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= t.download.title %></title>
    <meta name="description" content="<%= t.download.general_subtitle %>">
    <meta name="robots" content="noindex, follow">
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/vkx-tokens.css">
    <link rel="icon" href="/brand/VKX_Favicon.svg" type="image/svg+xml">
    <style>
        :root {
            --bg: #070B14;
            --card-1: rgba(255,255,255,0.045);
            --card-2: rgba(255,255,255,0.015);
            --border: rgba(255,255,255,0.09);
            --border-soft: rgba(255,255,255,0.06);
            --accent: #10B981;
            --accent-2: #34D399;
            --accent-soft: rgba(16,185,129,0.10);
            --text: #F6F8FB;
            --muted: #93A0B4;
            --muted-2: #5D6B80;
            --font: 'Inter', system-ui, sans-serif;
            --display: 'Sora', 'Outfit', system-ui, sans-serif;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        html, body { height: 100%; }
        body {
            background:
                radial-gradient(760px 420px at 82% -8%, rgba(16,185,129,0.14), transparent 62%),
                radial-gradient(680px 420px at -8% 108%, rgba(16,185,129,0.08), transparent 58%),
                var(--bg);
            color: var(--text); font-family: var(--font);
            min-height: 100dvh; display: flex; flex-direction: column;
            align-items: center; justify-content: center; padding: 28px 20px;
            -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
        }
        .card {
            position: relative;
            background: linear-gradient(180deg, var(--card-1), var(--card-2));
            border: 1px solid var(--border);
            border-radius: 26px; padding: 40px 30px 34px; width: 100%; max-width: 430px;
            text-align: center;
            box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset, 0 40px 90px -34px rgba(0,0,0,0.75);
            animation: rise .8s cubic-bezier(0.16,1,0.3,1) both;
        }
        .card::before {
            content:""; position:absolute; inset:0; border-radius:26px; padding:1px; pointer-events:none;
            background: linear-gradient(180deg, rgba(16,185,129,0.35), transparent 42%);
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude; opacity:.6;
        }
        @keyframes rise { from { opacity:0; transform: translateY(22px); } to { opacity:1; transform: none; } }

        .logo {
            width: 72px; height: 72px; border-radius: 20px; margin: 0 auto 24px;
            display:flex; align-items:center; justify-content:center;
            background: radial-gradient(120% 120% at 50% 0%, rgba(16,185,129,0.16), rgba(255,255,255,0.03));
            border:1px solid var(--border);
            box-shadow: 0 14px 40px -18px rgba(16,185,129,0.55);
        }
        .logo img { width: 46px; height: 46px; object-fit: contain; }

        .headline { font-family: var(--display); font-size: 29px; font-weight: 700; line-height: 1.14; letter-spacing: -0.5px; margin-bottom: 12px; }
        .headline b { color: var(--accent-2); font-weight: 700; }
        .subtitle { font-size: 14.5px; line-height: 1.62; color: var(--muted); margin: 0 auto 26px; max-width: 340px; }

        .gift {
            display:inline-flex; align-items:center; gap:9px; padding:9px 16px 9px 12px; margin-bottom: 26px;
            background: var(--accent-soft); border: 1px solid rgba(16,185,129,0.3); border-radius: 100px;
            font-size: 12.5px; font-weight: 600; color: #A7F3D0; letter-spacing: -0.1px;
        }
        .gift svg { color: var(--accent-2); flex-shrink:0; }
        .gift b { color: #ECFDF5; font-weight: 700; font-variant-numeric: tabular-nums; }

        .stores { display:flex; gap: 11px; }
        .badge {
            flex:1; display:flex; align-items:center; justify-content:center; gap:11px;
            background: linear-gradient(180deg, #12161F, #0C0F16);
            border:1px solid rgba(255,255,255,0.12); border-radius:15px;
            padding:13px 12px; text-decoration:none; color:#fff;
            transition: transform .15s ease, border-color .2s ease, background .2s ease;
        }
        .badge:active { transform: scale(0.975); }
        .badge:hover { border-color: rgba(16,185,129,0.4); background: linear-gradient(180deg, #161B26, #0E121A); }
        .badge svg { flex-shrink:0; }
        .badge .b-top { font-size: 8.5px; line-height:1; color:#9AA6B8; text-transform: uppercase; letter-spacing:.08em; font-weight:600; }
        .badge .b-main { font-size: 15px; font-weight: 700; line-height: 1.2; letter-spacing:-0.2px; }

        .trust { display:flex; justify-content:center; gap: 18px; margin-top: 24px; flex-wrap: wrap; }
        .trust span { display:inline-flex; align-items:center; gap:6px; font-size: 11px; color: var(--muted-2); font-weight: 600; letter-spacing:-0.1px; }
        .trust svg { color: var(--accent); opacity:.85; }

        .open-link { display:inline-block; margin-top: 22px; font-size: 12.5px; color: var(--muted); text-decoration: none; font-weight:600; }
        .open-link:hover { color: var(--text); }

        .footer { margin-top: 34px; text-align:center; }
        .footer-links { display:flex; gap: 18px; justify-content:center; margin-bottom: 11px; flex-wrap: wrap; }
        .footer-links a { font-size: 11.5px; color: var(--muted); text-decoration:none; font-weight:600; }
        .footer-links a:hover { color: var(--text); }
        .footer-copy { font-size: 9.5px; color: rgba(93,107,128,0.7); text-transform: uppercase; letter-spacing:.14em; font-weight:700; }

        .toast { position: fixed; bottom: 26px; background: var(--accent); color:#04231a; padding: 12px 22px; border-radius: 13px; font-size: 12.5px; font-weight: 800; transform: translateY(120px); transition: transform .4s cubic-bezier(0.16,1,0.3,1); box-shadow: 0 16px 40px -12px rgba(16,185,129,0.5); }
        .toast.show { transform: none; }
        @media (max-width: 380px) { .stores { flex-direction: column; } .trust { gap: 12px; } }
    </style>
</head>
<body>
    <main class="card">
        <div class="logo"><img src="/brand/VKX_Technologies_OnDark.svg" alt="VKX Wallet"></div>

        <h1 class="headline">
            <% if (ref) { %><%- t.download.invite_headline %><% } else { %><%- t.download.general_headline %><% } %>
        </h1>
        <p class="subtitle">
            <% if (ref) { %><%= t.download.invite_subtitle %><% } else { %><%= t.download.general_subtitle %><% } %>
        </p>

        <% if (ref) { %>
        <div class="gift">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/><path d="M12 8S10.5 3.5 8 3.5A2.5 2.5 0 0 0 8 8zM12 8s1.5-4.5 4-4.5A2.5 2.5 0 0 1 16 8z"/></svg>
            <span>Bônus ativado — código <b><%= ref %></b></span>
        </div>
        <% } %>

        <div class="stores">
            <a class="badge" id="btn-ios" href="https://apps.apple.com/app/vkx-wallet/id6759741026?mt=8<%= (function(){ var ct = []; if (typeof atribuicaoLoja !== 'undefined' && atribuicaoLoja) {   var p = new URLSearchParams(atribuicaoLoja);   if (p.get('src')) ct.push(p.get('src'));   if (p.get('utm_campaign') && p.get('utm_campaign') !== 'none') ct.push(p.get('utm_campaign'));   if (p.get('content')) ct.push(p.get('content')); } var token = ct.join('-').replace(/[^A-Za-z0-9_-]/g, '-').slice(0, 40); return token ? '&ct=' + encodeURIComponent(token) : '';})() %>">
                <svg width="23" height="23" viewBox="0 0 24 24" fill="#fff"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                <span style="text-align:left"><span class="b-top"><%= lang === 'en' ? 'Download on' : 'Baixar na' %></span><br><span class="b-main">App Store</span></span>
            </a>
            <a class="badge" id="btn-android" href="https://play.google.com/store/apps/details?id=com.vkinha.wallet<%= (typeof atribuicaoLoja !== 'undefined' && atribuicaoLoja) ? '&referrer=' + encodeURIComponent(atribuicaoLoja) : (ref ? '&referrer=' + encodeURIComponent('ref=' + ref) : '') %>">
                <svg width="21" height="21" viewBox="0 0 24 24"><path fill="#00D2FF" d="M3.6 1.8 13.8 12 3.6 22.2a1 1 0 0 1-.6-.9V2.7a1 1 0 0 1 .6-.9z"/><path fill="#00E676" d="M16.8 9 5.9 2.7l8.6 8.6L16.8 9z"/><path fill="#FF3D00" d="M16.8 15l-2.3-2.3-8.6 8.6L16.8 15z"/><path fill="#FFC400" d="m16.8 9 3.5 2a1 1 0 0 1 0 1.8l-3.5 2-2.3-2.9L16.8 9z"/></svg>
                <span style="text-align:left"><span class="b-top"><%= lang === 'en' ? 'Get it on' : 'Disponível no' %></span><br><span class="b-main">Google Play</span></span>
            </a>
        </div>

        <div class="trust">
            <span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <%= lang === 'en' ? 'Post-quantum' : 'Pós-quântica' %>
            </span>
            <span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15 19 4M18 5l2 2M15 8l2 2"/></svg>
                <%= lang === 'en' ? 'Non-custodial' : 'Não-custodial' %>
            </span>
            <span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                <%= lang === 'en' ? 'Rewards' : 'Recompensas' %>
            </span>
        </div>

        <a class="open-link" href="#" onclick="tryOpenApp(false); return false;"><%= lang === 'en' ? 'Already have the app? Open VKX Wallet' : 'Já tem o app? Abrir a VKX Wallet' %> →</a>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="https://vkxtech.com.br" target="_blank" rel="noreferrer"><%= lang === 'en' ? 'Website' : 'Site oficial' %></a>
            <a href="https://vkxtech.com.br/blog" target="_blank" rel="noreferrer">Blog</a>
            <a href="https://wallet.vkxtech.com.br/privacy-policy" target="_blank" rel="noreferrer"><%= lang === 'en' ? 'Privacy' : 'Privacidade' %></a>
            <a href="https://t.me/canalvkx" target="_blank" rel="noreferrer"><%= lang === 'en' ? 'Community' : 'Comunidade' %></a>
        </div>
        <div class="footer-copy">© 2026 VKX Technologies</div>
    </footer>

    <div class="toast" id="toast"><%= t.download.toast_copy %></div>

    <script>
        const refCode = "<%= ref %>";
        const DEEP_LINK = "vkxwallet://" + (refCode ? "?ref=" + encodeURIComponent(refCode) : "");
        const ua = navigator.userAgent;
        const isAndroid = /android/i.test(ua);
        const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const PLAY_STORE_URL = document.getElementById('btn-android').href;
        const APP_STORE_URL = document.getElementById('btn-ios').href;

        function tryOpenApp(disparoAutomatico) {
            const start = Date.now();
            window.location.href = DEEP_LINK;

            // 'open_app' so conta quando a pagina realmente saiu de cena (o app
            // instalado abriu). Antes era gravado em TODO carregamento mobile,
            // e no banco "open_app" nao significava app aberto.
            setTimeout(() => {
                if (document.visibilityState === 'hidden' && window.__vkxRegistraAberturaApp) {
                    window.__vkxRegistraAberturaApp();
                }
            }, 1500);

            // Com convite no iPhone, o desvio automático para a App Store é
            // desligado de propósito. Numa instalação nova o código só chega
            // ao app pela área de transferência, e o Safari do iOS só deixa
            // copiar depois de um TOQUE. Mandar o usuário para a loja sozinho
            // era exatamente o que fazia a indicação se perder.
            if (disparoAutomatico && isIOS && refCode) return;

            setTimeout(() => {
                if (Date.now() - start < 2500 && document.visibilityState !== 'hidden') {
                    if (isAndroid) {
                        // Desvio automatico para a Play e uma ida a loja tanto
                        // quanto o toque no botao: registra o store_click antes
                        // de navegar (o referrer ja vai na URL).
                        if (window.__vkxRegistraLoja) window.__vkxRegistraLoja('android');
                        window.location.href = PLAY_STORE_URL;
                    } else if (isIOS) {
                        window.location.href = APP_STORE_URL;
                    }
                }
            }, 1800);
        }

        // A cópia do convite saiu daqui: sem gesto do usuário o iOS recusa a
        // escrita e a tentativa no carregamento nunca funcionou. Agora ela
        // acontece no clique do botão da loja (bloco abaixo).

        // Auto-tenta abrir o app instalado; se não, o usuário escolhe a loja.
        if (isAndroid || isIOS) {
            setTimeout(() => { if (document.visibilityState !== 'hidden') tryOpenApp(true); }, 800);
        }
    </script>
<script>
// Clique em loja: e o evento mais proximo da instalacao que este dominio
// consegue observar. NAO e instalacao — a loja nao devolve confirmacao para
// ca. A confirmacao real chega pelo Install Referrer, dentro do app, no
// primeiro launch, e e reportada de la.
(function () {
  var params = new URLSearchParams(location.search);
  function envia(plataforma) {
    var corpo = {
      project: 'vkx-tech',
      eventName: 'store_click',
      product: 'wallet',
      contentType: 'store',
      contentId: plataforma,
      conversionType: 'store_click',
      utmSource: params.get('utm_source') || undefined,
      utmMedium: params.get('utm_medium') || undefined,
      utmCampaign: params.get('utm_campaign') || undefined,
      landingPage: location.pathname,
      referrer: document.referrer || undefined,
      metadata: { src: params.get('src') || null, content: params.get('content') || null }
    };
    try {
      // sendBeacon nao atrasa a navegacao para a loja.
      navigator.sendBeacon('https://vkxtech.com.br/api/growth/events', new Blob([JSON.stringify(corpo)], { type: 'text/plain' }));
    } catch (e) { /* telemetria nunca bloqueia o download */ }
  }
  var ios = document.getElementById('btn-ios');
  var android = document.getElementById('btn-android');
  if (ios) ios.addEventListener('click', function () { envia('ios'); });
  if (android) android.addEventListener('click', function () { envia('android'); });
  window.__vkxRegistraLojaEvento = envia;
})();
</script>
<script>
// Convite: cópia no toque + funil de indicação.
//
// Dois problemas reais foram resolvidos aqui:
//  1. A cópia do código para a área de transferência acontecia no carregamento
//     da página. O Safari do iOS exige gesto do usuário para escrever na área
//     de transferência, então ela FALHAVA sempre — e, sem ela, a instalação
//     nova pelo iPhone perdia o indicador.
//  2. Não existia contagem de clique de convite. Agora o servidor registra
//     visita, clique na loja e abertura do app, e é esse clique na loja que o
//     app do iPhone consulta depois: a Apple não tem equivalente ao Install
//     Referrer do Android, e a janela por IP é a única pista que sobra.
(function () {
  var params = new URLSearchParams(location.search);
  var REF = "<%= ref %>";
  var API = 'https://api.vkinha.com';
  var ua = navigator.userAgent || '';
  var plataforma = /iPad|iPhone|iPod/.test(ua) ? 'ios' : (/android/i.test(ua) ? 'android' : 'desktop');

  function registraConvite(tipo, plataformaEvento) {
    if (!REF) return;
    var corpo = JSON.stringify({
      ref_code: REF,
      platform: plataformaEvento || plataforma,
      event_type: tipo,
      source: 'wallet_download',
      utm_source: params.get('utm_source') || null,
      utm_medium: params.get('utm_medium') || null,
      utm_campaign: params.get('utm_campaign') || null
    });
    try {
      // sendBeacon não atrasa a ida para a loja e sobrevive à navegação.
      navigator.sendBeacon(API + '/growth/referral-click', new Blob([corpo], { type: 'text/plain' }));
    } catch (e) { /* telemetria nunca bloqueia o download */ }
  }

  function mostraToast() {
    var toast = document.getElementById('toast');
    if (!toast) return;
    toast.classList.add('show');
    setTimeout(function () { toast.classList.remove('show'); }, 3000);
  }

  function copiaLegado() {
    try {
      var campo = document.createElement('textarea');
      campo.value = 'vkxref:' + REF;
      campo.setAttribute('readonly', 'true');
      campo.style.position = 'fixed';
      campo.style.opacity = '0';
      document.body.appendChild(campo);
      campo.select();
      campo.setSelectionRange(0, 99999);
      if (document.execCommand('copy')) mostraToast();
      campo.remove();
    } catch (e) {}
  }

  function copiaConvite() {
    if (!REF) return;
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText('vkxref:' + REF).then(mostraToast).catch(copiaLegado);
        return;
      }
    } catch (e) {}
    copiaLegado();
  }

  registraConvite('landing_view');

  var ios = document.getElementById('btn-ios');
  var android = document.getElementById('btn-android');
  if (ios) ios.addEventListener('click', function () { copiaConvite(); registraConvite('store_click', 'ios'); });
  if (android) android.addEventListener('click', function () { copiaConvite(); registraConvite('store_click', 'android'); });

  window.__vkxRegistraAberturaApp = function () { registraConvite('open_app'); };
  // Usado pelo desvio automatico do Android: mesma dupla de eventos do toque.
  window.__vkxRegistraLoja = function (plataforma) {
    if (window.__vkxRegistraLojaEvento) window.__vkxRegistraLojaEvento(plataforma);
    registraConvite('store_click', plataforma);
  };
})();
</script>
</body>
</html>
