  <script>
    lucide.createIcons();

    function dismissSmartBanner() {
        const banner = document.getElementById('smart-app-banner');
        if (banner) {
            banner.style.display = 'none';
            sessionStorage.setItem('vkx_smart_banner_dismissed', 'true');
        }
    }

    function handleSmartBannerClick(e) {
        const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
        if (isMobile) {
            e.preventDefault();
            const start = Date.now();
            window.location.href = "vkxwallet://";
            setTimeout(() => {
                if (Date.now() - start < 2500 && document.visibilityState !== 'hidden') {
                    window.location.href = "<%= officialWalletUrl %>/download";
                }
            }, 1800);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('vkx_smart_banner_dismissed') === 'true') {
            const banner = document.getElementById('smart-app-banner');
            if (banner) banner.style.display = 'none';
        }
    });
  </script>
</body>
</html>

