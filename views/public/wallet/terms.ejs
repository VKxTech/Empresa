      <div class="p-3 bg-emerald-100 rounded-xl text-emerald-700 shrink-0 border border-emerald-200">
        <i data-lucide="building-2" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="font-sora font-bold text-slate-900 text-base mb-1.5"><%= content.product_notice_title %></h3>
