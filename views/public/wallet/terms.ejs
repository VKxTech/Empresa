        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center group-hover:border-emerald-400 transition-all">
          <i data-lucide="shield-check" class="w-5 h-5 text-emerald-600"></i>
        </div>
        <div class="flex flex-col">
          <span class="font-sora font-extrabold text-lg text-slate-900 group-hover:text-emerald-600 transition-colors">VKX Wallet</span>
          <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-600">Legal Portal</span>
        </div>
      </a>

      <!-- Language Selector & Actions -->
      <div class="flex items-center gap-3">
        
        <!-- Voltar para VKX Wallet Button -->
        <a href="<%= officialWalletUrl %>" class="inline-flex items-center gap-1.5 text-xs font-extrabold text-slate-700 hover:text-emerald-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-3.5 py-1.5 rounded-full transition-all shadow-sm">
