            <i data-lucide="globe" class="w-3.5 h-3.5 text-emerald-600"></i>
            <a href="?lang=en" class="px-1.5 py-0.5 rounded hover:text-emerald-600 <%= currentLang === 'en' ? 'text-emerald-700 font-extrabold bg-white shadow-sm' : '' %>">EN</a>
            <span class="text-slate-300">|</span>
            <a href="?lang=pt" class="px-1.5 py-0.5 rounded hover:text-emerald-600 <%= currentLang === 'pt' ? 'text-emerald-700 font-extrabold bg-white shadow-sm' : '' %>">PT</a>
            <span class="text-slate-300">|</span>
            <a href="?lang=es" class="px-1.5 py-0.5 rounded hover:text-emerald-600 <%= currentLang === 'es' ? 'text-emerald-700 font-extrabold bg-white shadow-sm' : '' %>">ES</a>
            <span class="text-slate-300">|</span>
            <a href="?lang=zh" class="px-1.5 py-0.5 rounded hover:text-emerald-600 <%= currentLang === 'zh' ? 'text-emerald-700 font-extrabold bg-white shadow-sm' : '' %>">ZH</a>
            <span class="text-slate-300">|</span>
            <a href="?lang=ar" class="px-1.5 py-0.5 rounded hover:text-emerald-600 <%= currentLang === 'ar' ? 'text-emerald-700 font-extrabold bg-white shadow-sm' : '' %>">AR</a>
          </div>
        </div>

        <a href="<%= officialWalletUrl %>/download" class="hidden sm:inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-full transition-all shadow-md shadow-emerald-600/20">
