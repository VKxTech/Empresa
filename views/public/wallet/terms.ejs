      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-extrabold uppercase tracking-wider mb-6">
        <i data-lucide="file-text" class="w-3.5 h-3.5 text-emerald-600"></i>
        <%= content.hero_tag %>
      </div>

      <h1 class="font-sora text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
        <%- content.hero_title %>
      </h1>

      <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed mb-6 font-normal">
        <%= content.hero_subtitle %>
      </p>

      <div class="inline-block text-xs font-bold text-slate-700 bg-white border border-slate-200 px-4 py-2 rounded-xl shadow-sm">
        <%= content.last_updated %>
      </div>
    </div>
  </section>

  <!-- Product vs Company Banner -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-10">
