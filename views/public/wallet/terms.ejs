              <span class="text-[11px] text-white/60 truncate">Abrir no app VKX Wallet</span>
          </div>
      </div>
      <a href="<%= officialWalletUrl %>/download" onclick="handleSmartBannerClick(event)" class="shrink-0 bg-[#007AFF] hover:bg-[#0062cc] active:scale-95 text-white font-extrabold text-xs px-4 py-1.5 rounded-full tracking-wider shadow-md transition-all ml-2">
          ABRIR
      </a>
  </div>

  <!-- Top Navigation Header -->
