          <p class="section-desc"><%= uiLang === 'pt' ? 'O que já entregamos e para onde estamos indo.' : uiLang === 'es' ? 'Lo que ya entregamos y hacia dónde vamos.' : 'What we have delivered and where we are headed.' %></p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 900px; margin: 0 auto;" class="reveal">
          <!-- Entregue (Últimos 4 meses) -->
          <div style="background: #ffffff; border: 1px solid var(--line); border-radius: 20px; padding: 30px; box-shadow: var(--shadow);">
            <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(5, 150, 105, 0.08); color: var(--green); padding: 6px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 20px;">
              <i data-lucide="check" style="width: 14px; height: 14px;"></i>
              <%= uiLang === 'pt' ? 'Últimos 4 Meses (Entregue)' : uiLang === 'es' ? 'Últimos 4 Meses (Entregado)' : 'Last 4 Months (Delivered)' %>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="check-circle" style="color: var(--green); flex-shrink: 0; width: 18px; height: 18px;"></i>
                +5.000 <%= uiLang === 'pt' ? 'Usuários Ativos' : uiLang === 'es' ? 'Usuarios Activos' : 'Active Users' %>
              </li>
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="check-circle" style="color: var(--green); flex-shrink: 0; width: 18px; height: 18px;"></i>
                Vault <%= uiLang === 'pt' ? 'de Autocustódia' : uiLang === 'es' ? 'de Autocustodia' : 'Self-Custody' %>
              </li>
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="check-circle" style="color: var(--green); flex-shrink: 0; width: 18px; height: 18px;"></i>
                Gas Shield BNB Chain
              </li>
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="check-circle" style="color: var(--green); flex-shrink: 0; width: 18px; height: 18px;"></i>
                <%= uiLang === 'pt' ? 'Copiloto de IA Integrado' : uiLang === 'es' ? 'Copiloto de IA Integrado' : 'Integrated AI Copilot' %>
              </li>
            </ul>
          </div>

          <!-- Próximos Passos -->
          <div style="background: #ffffff; border: 1px solid var(--line); border-radius: 20px; padding: 30px; box-shadow: var(--shadow);">
            <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(37, 99, 235, 0.08); color: var(--blue); padding: 6px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 20px;">
              <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
              <%= uiLang === 'pt' ? 'Próximos Marcos (Em Desenvolvimento)' : uiLang === 'es' ? 'Próximos Hitos (En Desarrollo)' : 'Upcoming Milestones (In Progress)' %>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="clock" style="color: var(--blue); flex-shrink: 0; width: 18px; height: 18px;"></i>
                <%= uiLang === 'pt' ? 'Suporte a novas Blockchains' : uiLang === 'es' ? 'Soporte a nuevas Blockchains' : 'Support for new Blockchains' %>
              </li>
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="clock" style="color: var(--blue); flex-shrink: 0; width: 18px; height: 18px;"></i>
                Staking <%= uiLang === 'pt' ? 'Simplificado' : uiLang === 'es' ? 'Simplificado' : 'Simplified Staking' %>
              </li>
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="clock" style="color: var(--blue); flex-shrink: 0; width: 18px; height: 18px;"></i>
                <%= uiLang === 'pt' ? 'DeFi Integrado' : uiLang === 'es' ? 'DeFi Integrado' : 'Integrated DeFi' %>
              </li>
              <li style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.95rem; color: var(--ink);">
                <i data-lucide="clock" style="color: var(--blue); flex-shrink: 0; width: 18px; height: 18px;"></i>
                <%= uiLang === 'pt' ? 'Recuperação Social de Conta' : uiLang === 'es' ? 'Recuperación Social de Cuenta' : 'Social Account Recovery' %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA DE CONVERSÃO -->
    <section class="cta-wrapper">
      <div class="container">
        <div class="cta reveal">
          <h2><%= landing.cta_title %></h2>
          <p><%= landing.cta_desc %></p>
          <div class="cta-actions">
            <a href="<%= downloadHref %>" class="btn btn-light js-download-link"><i data-lucide="download"></i><%= landing.btn_download %></a>
            <a href="<%= officialMainSiteUrl %>" target="_blank" rel="noreferrer" class="btn btn-ghost"><i data-lucide="globe"></i><%= landing.btn_official_site %></a>
            <a href="<%= officialBlogUrl %>" target="_blank" rel="noreferrer" class="btn btn-ghost"><i data-lucide="newspaper"></i><%= landing.btn_official_blog %></a>
          </div>
        </div>
      </div>
    </section>
    <!-- NEWSLETTER / INSCREVER-SE -->
    <section class="section newsletter-section" id="newsletter">
      <div class="container">
        <div class="newsletter-card reveal">
          <h2><%= landing.news_title %></h2>
          
          <form id="newsletter-form" class="newsletter-form">
            <div class="checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" name="updates" value="general" checked>
                <%= landing.news_check_general %>
              </label>
              <label class="checkbox-label">
                <input type="checkbox" name="updates" value="developer">
                <%= landing.news_check_dev %>
              </label>
            </div>
            
            <!-- Invisible Honeypot Field -->
            <input type="text" id="news-hp" name="news_hp" style="display: none !important;" tabindex="-1" autocomplete="off">
            
            <div class="email-input-wrap">
              <input type="email" id="news-email" required placeholder="<%= landing.news_placeholder %>">
            </div>
            
            <div class="recaptcha-badge">
              <div class="recaptcha-text">
                <span>protected by <strong>reCAPTCHA</strong></span>
                <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy</a> - 
                <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Terms</a>
              </div>
            </div>
            
            <button type="submit" class="btn-subscribe" id="btn-newsletter-submit">
              <%= landing.news_btn %>
              <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
            </button>
            
            <p class="newsletter-disclaimer"><%- landing.news_disclaimer %></p>
          </form>
          
          <div id="newsletter-success" class="newsletter-success-box" style="display: none;">
            <div class="success-icon">
              <i data-lucide="check-circle" style="width: 48px; height: 48px;"></i>
            </div>
            <h3 style="font-family: 'Sora', sans-serif; font-size: 1.25rem; color: var(--ink); margin: 0 0 10px;"><%= uiLang === 'pt' ? 'Inscrição realizada!' : uiLang === 'es' ? '¡Suscripción realizada!' : 'Subscription successful!' %></h3>
            <p style="color: var(--muted); font-size: 0.9rem; margin: 0;"><%= uiLang === 'pt' ? 'Obrigado por se inscrever. Você começará a receber nossas atualizações em breve.' : uiLang === 'es' ? 'Gracias por suscribirte. Comenzarás a recibir nuestras actualizaciones pronto.' : 'Thank you for subscribing. You will start receiving updates shortly.' %></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <div>© <%= landing.footer_rights %></div>
      <div class="footer-links">
        <a href="<%= officialMainSiteUrl %>" target="_blank" rel="noreferrer"><%= landing.btn_official_site %></a>
        <a href="<%= officialBlogUrl %>" target="_blank" rel="noreferrer"><%= landing.btn_official_blog %></a>
        <a href="<%= officialSupportUrl %>" target="_blank" rel="noreferrer"><%= t.contact.whatsapp_label %></a>
        <a href="<%= officialPrivacyUrl %>" target="_blank" rel="noreferrer"><%= uiLang === 'pt' ? 'Privacidade' : uiLang === 'es' ? 'Privacidad' : 'Privacy' %></a>
      </div>
      <div class="social-links">
        <a href="https://t.me/canalvkx" target="_blank" rel="noreferrer" title="Telegram"><i data-lucide="send" style="width: 16px; height: 16px;"></i></a>
        <a href="https://chat.whatsapp.com/F3erV36lzCB3i8PgrgFKsb" target="_blank" rel="noreferrer" title="WhatsApp"><i data-lucide="message-circle" style="width: 16px; height: 16px;"></i></a>
        <a href="https://www.instagram.com/vkxwallet?igsh=MThueXV3ZDJha3lyZA==" target="_blank" rel="noreferrer" title="Instagram"><i data-lucide="instagram" style="width: 16px; height: 16px;"></i></a>
      </div>
      <div class="footer-note"><%= landing.footer_disclaimer %></div>
    </div>
  </footer>

  <!-- STICKY MOBILE CTA -->
  <div class="sticky-footer">
    <a href="<%= downloadHref %>" class="btn btn-primary js-download-link" style="width: 100%;"><i data-lucide="smartphone"></i><%= landing.btn_download %></a>
  </div>

  <script>
    lucide.createIcons();
    
    // Download Link Setup preserving all current page query parameters
    const topbar = document.getElementById('topbar');
    const refCode = document.body.getAttribute('data-ref') || '';
    const downloadBase = document.body.getAttribute('data-download-base');
    
    const urlParams = new URLSearchParams(window.location.search);
    if (refCode && !urlParams.has('ref')) {
      urlParams.set('ref', refCode);
    }
    const paramsStr = urlParams.toString();
    const downloadUrl = paramsStr ? `${downloadBase}?${paramsStr}` : downloadBase;
    
    document.querySelectorAll('.js-download-link').forEach((link) => link.setAttribute('href', downloadUrl));
    
    // Sticky header
    const syncTopbar = () => window.scrollY > 12 ? topbar.classList.add('scrolled') : topbar.classList.remove('scrolled');
    syncTopbar();
    window.addEventListener('scroll', syncTopbar, { passive: true });
    
    // Intersection Observer for fade-in animations
    const items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const obs = new IntersectionObserver((entries) => entries.forEach((entry) => { 
        if (entry.isIntersecting) { 
          entry.target.classList.add('show'); 
          obs.unobserve(entry.target); 
        } 
      }), { threshold: 0.1 });
      items.forEach((item) => obs.observe(item));
    } else {
      items.forEach((item) => item.classList.add('show'));
    }

    // FAQ Accordion logic
    document.querySelectorAll('.faq-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.parentElement;
        const content = item.querySelector('.faq-content');
        const isActive = item.classList.contains('active');
        
        // Close all other items
        document.querySelectorAll('.faq-item').forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.classList.remove('active');
            otherItem.querySelector('.faq-content').style.maxHeight = null;
          }
        });
        
        if (isActive) {
          item.classList.remove('active');
          content.style.maxHeight = null;
        } else {
          item.classList.add('active');
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    });

    // Interactive Simulators Data & Logic
    const currentLang = '<%= uiLang %>';
    const simTranslations = {
      pt: {
        gas: [
          "1. Verificando saldos da carteira...",
          "2. Detectado: 100 USDT | 0.00 BNB (Sem saldo para taxas)",
          "3. Ativando Gas Shield: VKX assume e subsidia a taxa...",
          "4. ✓ Transação concluída com sucesso! 100 USDT transferidos sem BNB."
        ],
        gas_btn_start: "Simular Transação Sem BNB",
        gas_btn_reset: "Reiniciar Simulação",
        cross_calc: "Calculando rota otimizada...",
        cross_success: "✓ Melhor rota encontrada!",
        cross_time: "Tempo estimado: ~45s",
        cross_fee: "Taxa da rota: $0.15"
      },
      en: {
        gas: [
          "1. Checking wallet balances...",
          "2. Detected: 100 USDT | 0.00 BNB (Insufficient gas fee balance)",
          "3. Activating Gas Shield: VKX sponsors the network fee...",
          "4. ✓ Success! 100 USDT transferred without BNB."
        ],
        gas_btn_start: "Simulate Gasless Transaction",
        gas_btn_reset: "Reset Simulation",
        cross_calc: "Calculating optimal route...",
        cross_success: "✓ Best route found!",
        cross_time: "Estimated time: ~45s",
        cross_fee: "Route fee: $0.15"
      },
      es: {
        gas: [
          "1. Verificando saldos de la wallet...",
          "2. Detectado: 100 USDT | 0.00 BNB (Sin saldo para comisiones)",
          "3. Activando Gas Shield: VKX asume y subsidia la tasa...",
          "4. ✓ ¡Transacción exitosa! 100 USDT enviados sin BNB."
        ],
        gas_btn_start: "Simular Transacción Sin BNB",
        gas_btn_reset: "Reiniciar Simulador",
        cross_calc: "Calculando ruta optimizada...",
        cross_success: "¡Mejor ruta encontrada!",
        cross_time: "Tiempo estimado: ~45s",
        cross_fee: "Costo de la ruta: $0.15"
      }
    };

    // Gas Shield Simulator
    const btnRunGas = document.getElementById('btn-run-gas-sim');
    const consoleOutput = document.getElementById('sim-console-output');
    const bnbVal = document.getElementById('sim-bnb-val');
    let isGasSimRunning = false;

    btnRunGas.addEventListener('click', () => {
      if (isGasSimRunning) {
        // Reset
        consoleOutput.innerHTML = `<div class="sim-console-line show">Waiting for simulation...</div>`;
        bnbVal.textContent = "0.00 BNB";
        bnbVal.classList.add('red-val');
        btnRunGas.textContent = simTranslations[currentLang].gas_btn_start;
        isGasSimRunning = false;
        return;
      }

      isGasSimRunning = true;
      btnRunGas.disabled = true;
      consoleOutput.innerHTML = '';
      
      const steps = simTranslations[currentLang].gas;
      let currentStep = 0;

      const runStep = () => {
        if (currentStep < steps.length) {
          const line = document.createElement('div');
          line.className = 'sim-console-line';
          line.textContent = steps[currentStep];
          
          if (currentStep === 2) {
            line.classList.add('highlight');
          }
          
          if (currentStep === 3) {
            line.classList.add('highlight');
            bnbVal.textContent = "0.00 BNB (Shielded)";
            bnbVal.classList.remove('red-val');
            bnbVal.style.color = "var(--green)";
          }

          consoleOutput.appendChild(line);
          setTimeout(() => line.classList.add('show'), 50);
          
          currentStep++;
          setTimeout(runStep, 1000);
        } else {
          btnRunGas.disabled = false;
          btnRunGas.textContent = simTranslations[currentLang].gas_btn_reset;
        }
      };

      runStep();
    });

    // Cross-Chain Router Simulator
    const btnRunRouter = document.getElementById('btn-run-router');
    const routerPlaceholder = document.getElementById('router-placeholder');
    const routerData = document.getElementById('router-data');
    const routerStatus = document.getElementById('router-result-status');
    const routerTime = document.getElementById('router-est-time');
    const routerFee = document.getElementById('router-est-fee');
    const routerFrom = document.getElementById('router-from');
    const routerTo = document.getElementById('router-to');
    const routerAmount = document.getElementById('router-amount');

    btnRunRouter.addEventListener('click', () => {
      const fromVal = routerFrom.options[routerFrom.selectedIndex].text;
      const toVal = routerTo.options[routerTo.selectedIndex].text;
      const amountVal = parseFloat(routerAmount.value) || 100;

      if (routerFrom.value === routerTo.value) {
        alert(currentLang === 'pt' ? 'Por favor selecione redes diferentes!' : 'Please select different networks!');
        return;
      }

      btnRunRouter.disabled = true;
      routerPlaceholder.style.display = 'block';
      routerData.style.display = 'none';
      routerPlaceholder.textContent = simTranslations[currentLang].cross_calc;

      setTimeout(() => {
        routerPlaceholder.style.display = 'none';
        routerData.style.display = 'block';
        
        routerStatus.textContent = simTranslations[currentLang].cross_success;
        routerTime.textContent = "~45s";
        
        // Calculate dynamic mock fee
        const calculatedFee = (amountVal * 0.0015).toFixed(2);
        routerFee.textContent = `$${Math.max(parseFloat(calculatedFee), 0.15).toFixed(2)}`;

        btnRunRouter.disabled = false;
      }, 1200);
    });

    // Tracking Event Listeners
    document.querySelectorAll('.js-download-link').forEach(btn => {
      btn.addEventListener('click', () => {
        if (typeof clarity === 'function') {
          clarity('event', 'download_click');
        }
        if (typeof fbq !== 'undefined') {
          fbq('track', 'Lead');
        }
      });
    });

    // Newsletter Submission Logic
    const newsletterForm = document.getElementById('newsletter-form');
    const newsletterSuccess = document.getElementById('newsletter-success');
    const btnNewsletterSubmit = document.getElementById('btn-newsletter-submit');
    const newsEmail = document.getElementById('news-email');

    if (newsletterForm) {
      newsletterForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const emailVal = newsEmail.value.trim();
        if (!emailVal) return;

        // Antispam / Honeypot Check
        const honeypot = document.getElementById('news-hp')?.value || '';
        if (honeypot) {
          console.warn('Honeypot filled - Bot detected.');
          return;
        }

        const updates = [];
        newsletterForm.querySelectorAll('input[name="updates"]:checked').forEach(cb => {
          updates.push(cb.value);
        });

        // Capture UTMs & referral parameters
        const urlParams = new URLSearchParams(window.location.search);
        const utm_source = urlParams.get('utm_source') || '';
        const utm_medium = urlParams.get('utm_medium') || '';
        const utm_campaign = urlParams.get('utm_campaign') || '';
        const utm_content = urlParams.get('utm_content') || '';
        const ref = urlParams.get('ref') || document.body.getAttribute('data-ref') || '';

        btnNewsletterSubmit.disabled = true;
        const originalText = btnNewsletterSubmit.innerHTML;
        btnNewsletterSubmit.textContent = currentLang === 'pt' ? 'ENVIANDO...' : currentLang === 'es' ? 'ENVIANDO...' : 'SUBSCRIBING...';

        try {
          const response = await fetch('/newsletter/subscribe', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              email: emailVal,
              updates: updates,
              utm_source,
              utm_medium,
              utm_campaign,
              utm_content,
              ref
            })
          });

          const result = await response.json();
          if (response.ok && result.success) {
            newsletterForm.style.display = 'none';
            newsletterSuccess.style.display = 'block';
            if (typeof clarity === 'function') {
              clarity('event', 'newsletter_subscribe');
            }
            if (typeof fbq !== 'undefined') {
              fbq('track', 'CompleteRegistration');
            }
          } else {
            alert(result.error || result.message || (currentLang === 'pt' ? 'Erro ao realizar inscrição.' : 'Error during subscription.'));
            btnNewsletterSubmit.disabled = false;
            btnNewsletterSubmit.innerHTML = originalText;
          }
        } catch (err) {
          console.error('Newsletter error:', err);
          alert(currentLang === 'pt' ? 'Erro de conexão com o servidor.' : 'Connection error with the server.');
          btnNewsletterSubmit.disabled = false;
          btnNewsletterSubmit.innerHTML = originalText;
        }
      });
    }

    // Language selection preservation of query parameters
    document.querySelectorAll('.js-lang-select').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetLang = link.getAttribute('data-lang');
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('lang', targetLang);
        window.location.href = window.location.pathname + '?' + urlParams.toString();
      });
    });
  </script>
</body>
</html>
