              <span class="mock-balance-val">$1,240.50</span>
              <div class="mock-badge-status">
                <i data-lucide="shield-check" style="width: 12px; height: 12px;"></i>
                <span>Gas Shield Active</span>
              </div>
            </div>
            
            <div class="mock-actions">
              <div class="mock-act-btn"><i data-lucide="arrow-up-right"></i><span>Enviar</span></div>
              <div class="mock-act-btn"><i data-lucide="arrow-down-left"></i><span>Receber</span></div>
