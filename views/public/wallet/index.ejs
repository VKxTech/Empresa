          </div>
        </div>
      </div>
    </section>

    <%# ===================================================================
        O PRODUTO POR DENTRO — capturas reais do aplicativo.
        Cada bloco abaixo corresponde a uma tela de verdade em public/wallet:
        compra em moeda local, ativos tokenizados, swap cross-chain, conta,
        seletor de redes e Quantum Shield. O texto vem de `productShowcase`
        e as imagens de `walletShots`, para nada ser escrito duas vezes.
        =================================================================== %>
    <section class="product-proof-section" id="produto">
      <canvas class="wallet-hero-canvas" id="proof-canvas" aria-hidden="true"></canvas>
      <div class="container">
        <div class="showcase-intro reveal">
          <div class="eyebrow"><i data-lucide="smartphone"></i><%= product.eyebrow %></div>
          <h2><%= product.title %></h2>
          <p class="section-desc"><%= product.intro %></p>
          <div class="trust-strip">
            <% product.fiat_tags.forEach((tag) => { %><span><%= tag %></span><% }) %>
          </div>
        </div>

        <%# Tela inicial em destaque: a prova de que o restante da página existe. %>
        <div class="real-device-stage reveal">
          <div class="real-device">
            <img
              class="real-app-shot"
              src="<%= shot('home') %>"
              alt="<%= product.eyebrow %> — VKX Wallet"
              width="589"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <div class="floating-proof one"><i data-lucide="key-round"></i><%= product.proof_one %></div>
            <div class="floating-proof two"><i data-lucide="layers"></i><%= product.proof_two %></div>
          </div>
        </div>

        <div class="feature-showcase">
          <%# 1. Compra em moeda local: Pix, euros, dólares e cartão. %>
          <article class="feature-row reveal">
            <div class="feature-copy">
              <span class="feature-kicker"><%= product.eyebrow %></span>
              <h3><%= product.fiat_title %></h3>
              <p><%= product.fiat_body %></p>
              <div class="feature-tags">
                <% product.fiat_tags.forEach((tag) => { %><span><i data-lucide="check"></i><%= tag %></span><% }) %>
              </div>
              <p class="feature-note"><%= product.fiat_note %></p>
            </div>
            <div class="feature-media">
              <div class="screen-card">
                <img src="<%= shot('buy') %>" alt="<%= product.fiat_title %>" width="589" height="1280" loading="lazy" decoding="async" />
                <span class="screen-proof-label"><%= product.proof %></span>
              </div>
            </div>
          </article>

          <%# 2. Ações, ETFs e RWA tokenizados. %>
          <article class="feature-row reverse reveal">
            <div class="feature-copy">
