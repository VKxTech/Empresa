          <div class="pill-row">
            <div class="pill"><span class="dot"></span><%= landing.pill_product %></div>
            <div class="pill"><span class="dot blue-dot"></span><%= landing.pill_simple %></div>
            <div class="pill"><i data-lucide="shield-check"></i><%= landing.pill_secure %></div>
          </div>
          <h1><%- landing.hero_title %></h1>
          <p class="lead"><%= landing.hero_desc %></p>
          
          <div class="hero-actions">
            <a href="<%= downloadHref %>" class="btn btn-primary js-download-link"><i data-lucide="smartphone"></i><%= landing.btn_download %></a>
            <a href="#problema" class="btn btn-secondary"><i data-lucide="sparkles"></i><%= landing.btn_understand %></a>
          </div>
          
          <div class="proof-bar">
            <div class="proof-grid">
              <div class="proof-item">
                <span class="proof-number"><%= landing.proof_users_title %></span>
                <span class="proof-label"><%= landing.proof_users_desc %></span>
              </div>
              <div class="proof-item">
                <span class="proof-number"><%= landing.proof_protected_title %></span>
                <span class="proof-label"><%= landing.proof_protected_desc %></span>
              </div>
              <div class="proof-item">
                <span class="proof-number"><%= landing.proof_vault_title %></span>
                <span class="proof-label"><%= landing.proof_vault_desc %></span>
              </div>
              <div class="proof-item">
                <span class="proof-number"><%= landing.proof_evolution_title %></span>
                <span class="proof-label"><%= landing.proof_evolution_desc %></span>
              </div>
              <div class="proof-note"><%= landing.proof_update_note %></div>
            </div>
          </div>
        </div>
        
        <div class="mockup-container reveal show">
          <div class="phone-mockup">
            <div class="phone-notch"></div>
            <div class="mock-header">
              <span class="mock-logo">VKX Wallet</span>
              <div style="display: flex; gap: 8px;">
                <i data-lucide="wifi" style="width: 14px;"></i>
                <i data-lucide="battery" style="width: 14px;"></i>
              </div>
            </div>
            
            <div class="mock-balance-card">
